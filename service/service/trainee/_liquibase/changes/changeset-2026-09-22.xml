<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

        <changeSet id="1" author="mohamed.ehab">
            <addColumn tableName="oa_trainee">
                <column name="referral_employee_id" type="INT">
                    <constraints nullable="true"/>
                </column>
            </addColumn>

            <addForeignKeyConstraint
                    constraintName="fk_trainee_referral_employee"
                    baseTableName="oa_trainee"
                    baseColumnNames="referral_employee_id"
                    referencedTableName="oa_employee"
                    referencedColumnNames="id"/>
        </changeSet>

</databaseChangeLog>